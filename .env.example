EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# La API de iTunes Search no requiere key ni token.
#
# Ninguna de estas dos va aquí -- viven solo como secrets de sus respectivas
# Supabase Edge Functions, nunca en el bundle del cliente:
#   - Last.fm:  supabase secrets set LASTFM_API_KEY=xxxx
#               (supabase/functions/lastfm-similar)
#   - Spotify:  supabase secrets set SPOTIFY_CLIENT_ID=xxxx SPOTIFY_CLIENT_SECRET=xxxx
#               (supabase/functions/spotify-track-link -- Client Credentials
#               flow, app auth only, no user login. El Client Secret NUNCA
#               debe vivir en EXPO_PUBLIC_* ni en el bundle del cliente.)

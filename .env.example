EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (src/lib/revenuecat.ts) -- API keys públicas del proyecto (Project settings ->
# API keys en el dashboard de RevenueCat), una por plataforma. Sin esto, isRevenueCatConfigured()
# devuelve false y toda la app cae a modo gratuito sin romper nada (ver paywall en app/premium.tsx).
# El entitlement que se compra debe llamarse EXACTAMENTE "premium" en el dashboard de RevenueCat
# (Entitlements -> + New) -- si se nombra distinto, actualizar PREMIUM_ENTITLEMENT_ID en revenuecat.ts.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Google Sign-In (src/api/googleAuth.ts) -- el "Web client ID" de OAuth 2.0 de Google Cloud
# Console (tipo "Aplicación web", NO el de iOS/Android). Es el que Supabase usa para
# verificar el idToken del lado del servidor -- sin esto, GoogleSignin.configure() no
# funciona aunque el resto de las credenciales estén bien puestas.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# La API de iTunes Search no requiere key ni token.
#
# Ninguna de estas dos va aquí -- viven solo como secrets de sus respectivas
# Supabase Edge Functions, nunca en el bundle del cliente:
#   - Last.fm:  supabase secrets set LASTFM_API_KEY=xxxx
#               (supabase/functions/lastfm-similar)
#   - Spotify:  supabase secrets set SPOTIFY_CLIENT_ID=xxxx SPOTIFY_CLIENT_SECRET=xxxx
#               (supabase/functions/spotify-track-link -- Client Credentials
#               flow, app auth only, no user login. El Client Secret NUNCA
#               debe vivir en EXPO_PUBLIC_* ni en el bundle del cliente.)

# ---------------------------------------------------------------------------
# BUILDS DE EAS: estas variables NO viajan en el repo (2026-09-13)
# ---------------------------------------------------------------------------
# Las EXPO_PUBLIC_* se hornean dentro del binario EN TIEMPO DE BUILD, y EAS Build
# no sube este .env (esta gitignored). Sin definirlas del lado de EAS, un APK sale
# con todas vacias: RevenueCat no se configura (el paywall no muestra planes y la
# compra es imposible) y Supabase queda muerto (sin deck, sin biblioteca, sin feed).
#
# Se intento resolverlo con un bloque `env` en eas.json y se REVIRTIO: este repo es
# PUBLICO, y aunque la anon key de Supabase y la key de RevenueCat son publicas por
# diseno (ya viajan dentro de cualquier APK), dejarlas en el historial de git dispara
# el secret scanning de GitHub y las expone a los bots que rastrean repos publicos.
#
# Van al dashboard de EAS, una vez por entorno:
#
#   eas env:create --environment preview --name EXPO_PUBLIC_SUPABASE_URL --value "..."
#   eas env:create --environment preview --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..."
#   eas env:create --environment preview --name EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID --value "..."
#   eas env:create --environment preview --name EXPO_PUBLIC_REVENUECAT_API_KEY_IOS --value "..."
#
# Repetir con --environment development para el dev client. Para `production` van las
# keys REALES de tienda (appl_/goog_), nunca las test_.
#
# Comprobar antes de gastar un build:  eas env:list --environment preview
